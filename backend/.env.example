MONGO_URI=mongodb://127.0.0.1:27017/courier_parcel?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
# Comma-separated frontend origins are supported.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# Set to the trusted reverse-proxy hop count when deployed behind one.
TRUST_PROXY=

# Booking price configuration (integer poisha and basis points; 100 bps = 1%).
DELIVERY_FEE_SAME_BRANCH_POISHA=6000
DELIVERY_FEE_INTER_BRANCH_POISHA=10000
COD_FEE_BASIS_POINTS=100

# Local synthetic seed only. The script generates a one-time password if blank.
SEED_PASSWORD=
NODEMAILER_EMAIL=
NODEMAILER_PASS=
EMAIL_SERVICE=gmail

# Optional: used only by npm run create-admin, never by public registration.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
# Leave blank to generate a random password, printed once by create-admin.
ADMIN_PASSWORD=
